# Copy to .env.local and fill in. All values are optional: without them the
# app runs fully offline and the Ask page uses its rule-based parser.

AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Web grounding for company resolution. Optional: Wikipedia is used by default
# and needs no key. Set one of these to use a general search API instead.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
